# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
LOG_LEVEL=info

# These match docker-compose.yml (local-only credentials)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379

API_HOST=0.0.0.0
API_PORT=3000

WORKER_CONCURRENCY=20

# SSRF escape hatch for local/integration tests ONLY. The app refuses to start
# with this set to true when NODE_ENV=production.
ALLOW_PRIVATE_TARGETS=false
